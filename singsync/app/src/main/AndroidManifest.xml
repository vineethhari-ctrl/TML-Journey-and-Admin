<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Long-running, user-visible separation job -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only needed to write into Music/SingSync on Android 8-9; Android 10+ uses MediaStore without it -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Recording (Milestone 4) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- NOTE: deliberately NO android.permission.INTERNET until the duet milestone: core features cannot phone home. -->

    <application
        android:name=".SingSyncApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="SingSync"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.SingSync">

        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".processing.ProcessingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
